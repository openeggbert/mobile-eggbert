{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CNA_USE_CCACHE": "ON",
        "EASYGL_BUILD_TESTS": "OFF",
        "EASYGL_BUILD_EXAMPLES": "OFF"
      },
      "environment": {
        "CCACHE_DIR": "${sourceDir}/build/ccache",
        "CCACHE_BASEDIR": "${sourceDir}/../..",
        "CCACHE_NOHASHDIR": "1",
        "CCACHE_MAXSIZE": "30G"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CNA_SDL_PREBUILT_ROOT": "${sourceDir}/.sdl-prebuilt"
      }
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CNA_SDL_PREBUILT_ROOT": "${sourceDir}/build/dependencies/sdl-web"
      },
      "environment": {
        "EM_CACHE": "${sourceDir}/build/emscripten-cache"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "cacheVariables": {
        "CNA_SDL_PREBUILT_ROOT": "${sourceDir}/build/dependencies/sdl-windows",
        "CNA_WINDOWS_DEPENDENCIES_ROOT": "${sourceDir}/build/dependencies/windows"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CNA_SDL_PREBUILT_ROOT": "${sourceDir}/build/dependencies/sdl-macos"
      }
    },
    {
      "name": "macos-metal",
      "displayName": "macos: METAL",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-metal",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "METAL"
      }
    },
    {
      "name": "macos-opengl33",
      "displayName": "macos: OPENGL33",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-opengl33",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL33"
      }
    },
    {
      "name": "macos-sdl-renderer",
      "displayName": "macos: SDL_RENDERER",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-sdl-renderer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_RENDERER"
      }
    },
    {
      "name": "linux-sdl-renderer",
      "displayName": "linux: SDL_RENDERER",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-sdl-renderer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_RENDERER"
      }
    },
    {
      "name": "linux-opengles3",
      "displayName": "linux: OPENGLES3",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-opengles3",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES3"
      }
    },
    {
      "name": "linux-opengl33",
      "displayName": "linux: OPENGL33",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-opengl33",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL33"
      }
    },
    {
      "name": "linux-vulkan",
      "displayName": "linux: VULKAN",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-vulkan",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "VULKAN"
      }
    },
    {
      "name": "linux-webgpu",
      "displayName": "linux: WEBGPU",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-webgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      }
    },
    {
      "name": "linux-headless",
      "displayName": "linux: HEADLESS",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-headless",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "HEADLESS"
      }
    },
    {
      "name": "linux-software",
      "displayName": "linux: SOFTWARE",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-software",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SOFTWARE"
      }
    },
    {
      "name": "linux-stub",
      "displayName": "linux: STUB",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-stub",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "STUB"
      }
    },
    {
      "name": "linux-sdl-gpu",
      "displayName": "linux: SDL_GPU",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-sdl-gpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_GPU"
      }
    },
    {
      "name": "linux-fna3d",
      "displayName": "linux: FNA3D",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-fna3d",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "FNA3D"
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "web: WEBGL2",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web-webgl2",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL2"
      }
    },
    {
      "name": "web-webgpu",
      "displayName": "web: WEBGPU",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web-webgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      }
    },
    {
      "name": "windows-directx11",
      "displayName": "windows: DIRECTX11",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-directx11",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX11"
      }
    },
    {
      "name": "windows-directx9",
      "displayName": "windows: DIRECTX9",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-directx9",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX9"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-sdl-renderer",
      "configurePreset": "linux-sdl-renderer",
